  "events": [
    {
      "year": 1927,
      "event": "built",
      "note": "Built by the State of New Hampshire as a replacement for the Mt. Israel lookout. Eastern lookouts says the 27-foot tower was erected with $1175 in private funds and then given to the state.",
      "from": "research",
      "source_url": "http://nhlr.org/lookouts/us/nh/red-hill-tower/",
      "source_urls": [
        "http://nhlr.org/lookouts/us/nh/red-hill-tower/",
