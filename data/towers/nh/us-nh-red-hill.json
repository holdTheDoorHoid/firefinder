      ]
    },
    {
      "year": 1972,
      "event": "modified",
      "note": "Height change disputed. The register says the tower was raised to 55 feet and given an observation platform. Eastern lookouts says a 10-foot extension brought it to 37 feet.",
      "from": "research",
      "source_url": "http://nhlr.org/lookouts/us/nh/red-hill-tower/",
      "source_urls": [
        "http://nhlr.org/lookouts/us/nh/red-hill-tower/",
        "https://easternuslookouts.weebly.com/red-hill.html"
      ]
    },
    {
      "year": 1981,
      "event": "closed",
      "note": "Closed by the state. The Town of Moultonborough then signed a lease, and the local fire department took over detection duties.",
      "from": "research",
      "source_url": "http://nhlr.org/lookouts/us/nh/red-hill-tower/",
      "source_urls": [
        "http://nhlr.org/lookouts/us/nh/red-hill-tower/",
        "https://easternuslookouts.weebly.com/red-hill.html"
      ]
    },
    {
      "year": 2003,
      "event": "nhlr_registered",
      "note": "Registered August 5, 2003 (US 526, NH 18)",
      "from": "research",
      "source_url": "http://nhlr.org/lookouts/us/nh/red-hill-tower/"
    },
    {
      "year": 2009,
      "event": "other",
      "note": "Town received a Forest Fire Lookout Association restoration grant to repaint the tower. No painting followed.",
      "from": "research",
      "source_url": "https://firelookout.org/wp-content/uploads/2024/11/cr-nh-2011.pdf"
    },
    {
      "year": 2010,
      "event": "other",
      "note": "FFLA restoration grant awarded for scraping and painting the tower and cab plus other maintenance; grantee was the Moultonborough Fire Department; the Lakes Region Conservation Trust owns the land.",
      "from": "ffla_east_reports",
      "source_url": "https://firelookout.org/wp-content/uploads/2024/11/cr-restoration-2010.pdf"
    },
    {
      "year": 2010,
      "event": "restored",
      "note": "Watchman Ed Maheux and an assistant replaced the shingles on the roof of the tower cab.",
      "from": "ffla_east_reports",
      "source_url": "https://firelookout.org/wp-content/uploads/2024/11/cr-nh-2010.pdf"
    },
    {
      "year": 2011,
      "event": "assessed",
      "note": "Inspections in June and November found no work done and no attempt to paint the cab or steelwork. In December the selectmen voted to end the town's lease and return the site to the Lakes Region Conservation Trust.",
      "from": "research",
      "source_url": "https://firelookout.org/wp-content/uploads/2024/11/cr-nh-2011.pdf"
    },
    {
      "year": 2012,
      "event": "other",
      "note": "The effort to operate the tower did not succeed, and the grant money was sent to the FFLA treasurer to close the matter.",
      "from": "research",
      "source_url": "https://firelookout.org/wp-content/uploads/2024/11/cr-nh-2012.pdf"
    },
    {
      "year": 2016,
      "event": "assessed",
      "note": "Visit report: needs paint; wood on every landing rotting and not properly secured. The visitor found the tower apparently staffed by Moultonborough residents but not staffed that day.",
      "from": "research",
      "source_url": "http://nhlr.org/lookouts/us/nh/red-hill-tower/"
    },
    {
      "year": 2025,
      "event": "staffed",
      "note": "Continues to be operated by a private association",
      "from": "research",
      "source_url": "https://firelookout.org/wp-content/uploads/2026/01/cr-nh-2025.pdf"
    }
  ],
