  "access": {
    "level": "restricted",
    "note": "On emergency status, not staffed since 1997, and described as in poor shape. No source describes public entry into the cabin; ask the Salmon-Challis National Forest before going."
  },
  "staffing": {
    "status": "unknown",
    "as_of": null
  },
  "visit": {
    "climbable": null,
    "drive_up": false,
    "trail_note": "Vehicle access on the Sleeping Deer Road (FS-086, 22 miles from the saddle) to within 2 miles of the summit. A signed trail from the road end climbs just over a mile. The Forest Service lists a 0.5-mile trail from the Cabin Creek and Melville Ridge trails. Cellphone service is usually unavailable."
  },
