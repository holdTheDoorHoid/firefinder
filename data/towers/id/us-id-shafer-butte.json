    },
    {
      "year": 1928,
      "event": "other",
      "note": "Official opening of the lookout station (September 28, 1928 item), attended by Senator William E. Borah and the U.S. chief forester.",
      "from": "research",
      "source_url": "https://idaholookouts.weebly.com/shaffer-butte.html"
    },
    {
      "year": 1929,
      "event": "other",
      "note": "June 29, 1929: forest office reports the road to the lookout is now negotiable for automobiles. September 27, 1929: with fire danger over, lookouts and crews are taken out, but lookouts will be kept on the butte for emergency purposes.",
      "from": "research",
      "source_url": "https://idaholookouts.weebly.com/shaffer-butte.html"
    },
    {
      "year": 1936,
      "event": "other",
      "note": "October 6, 1936 item: a 1495-pound periscope borrowed from the United States navy for experimental purposes was used on Shafer Butte for the first time in actual fire detection; results reported as highly satisfactory.",
      "from": "research",
      "source_url": "https://idaholookouts.weebly.com/shaffer-butte.html"
    },
    {
      "year": 1945,
      "event": "staffed",
      "note": "Mrs. Lucy Schlosman on lookout duty (January 28, 1945 item); she looked after weather instruments and called in readings four times a day.",
