  "agency": "U.S. Forest Service, Boise National Forest (per NHLR); the climbing guide says the Forest Service no longer uses the lookout",
  "ownership": "federal",
  "access": {
    "level": "restricted",
    "note": "Used by the Bogus Basin ski patrol and for emergencies. The climbing guide says roads to the summit are not open to motorcycles or ATVs except government and Bogus Basin vehicles. No public visiting is described in these sources."
  },
  "staffing": {
    "status": "unstaffed",
    "as_of": "2021"
  },
  "visit": {
    "climbable": null,
    "drive_up": null,
    "trail_note": "The summit sits inside the Bogus Basin ski area. Roads and cat tracks lead toward the summit, and the climbing guide describes summer hiking and biking there. The cab itself is not described as open to visitors."
  },
  "rental": null,
