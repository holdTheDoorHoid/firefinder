    },
    {
      "year": 1926,
      "event": "built",
      "note": "Lookout cabin completed in 1926 after the Forest budgeted for it in 1925; 2015 tree-ring dating of logs fits the late 1920s",
      "from": "research",
      "source_url": "https://npshistory.com/publications/usfs/region/3/santa-fe/fire-lookout-history.pdf"
    },
    {
      "year": 1928,
      "event": "built",
      "note": "Enclosed metal cab, only about 4 by 4 feet, on a 30-foot metal tower by 1928 (Zinn)",
      "from": "research",
      "source_url": "https://npshistory.com/publications/usfs/region/3/santa-fe/fire-lookout-history.pdf"
    },
    {
      "year": 1949,
      "event": "abandoned",
      "note": "Regional Office decided to abandon Barillas in 1949 instead of building a road and new tower; old tower had been condemned in the late 1940s",
      "from": "research",
      "source_url": "https://npshistory.com/publications/usfs/region/3/santa-fe/fire-lookout-history.pdf"
    },
    {
      "year": 1950,
      "event": "fire",
      "note": "Commissary Fire started June 6, 1950 below the abandoned lookout; Board of Review said a guard on the peak might have held it down",
      "from": "research",
      "source_url": "https://npshistory.com/publications/usfs/region/3/santa-fe/fire-lookout-history.pdf"
    },
    {
      "year": 1950,
