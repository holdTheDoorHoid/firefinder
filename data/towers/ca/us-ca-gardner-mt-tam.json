    },
    {
      "year": 1940,
      "event": "staffed",
      "note": "Henry A. Long died in January 1940 after six years as Mount Tamalpais lookout; Fred Petri appointed in May 1940",
      "from": "research",
      "source_url": "https://californialookouts.weebly.com/mount-tamalpais-gardner.html"
    },
    {
      "year": 1946,
      "event": "fire",
      "note": "Lookout spotted a San Anselmo fire that was hard to locate from the ground; about half an acre of grass burned",
      "from": "research",
      "source_url": "https://californialookouts.weebly.com/mount-tamalpais-gardner.html"
    },
    {
      "year": 2014,
      "event": "other",
      "note": "Four remote fire-detection cameras ($207,000 system, PG&E grant to FIRESafe Marin); two give 24-hour coverage on Mount Tamalpais and Mount Barnabe, where lookouts are daytime-only and volunteer-staffed",
