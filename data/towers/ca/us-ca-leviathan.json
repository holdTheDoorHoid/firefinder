  "access": {
    "level": "restricted",
    "note": "Public road ends at a locked gate about a quarter mile from the tower; the last section is for service vehicles, per a third-party guide. The summit also has transmission facilities."
  },
  "staffing": {
    "status": "unknown",
    "as_of": null
  },
  "visit": {
    "climbable": null,
    "drive_up": true,
    "trail_note": "4WD recommended on Leviathan Peak Road (Forest Road 31057); the road is closed in winter and usually opens early April to late November, per a third-party guide. The sources read do not say whether the cab may be entered."
  },
  "rental": null,
