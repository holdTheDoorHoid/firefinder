  "access": {
    "level": "restricted",
    "note": "CalWild describes a hiking trail to the lookout. Fire-lookouts.org (last updated 2013) says the structure is not staffed and is closed to the public, and NHLR says the cab is used only in emergencies. No source describes a visitor entry arrangement."
  },
  "staffing": {
    "status": "unstaffed",
    "as_of": "2013"
  },
  "visit": {
    "climbable": false,
    "drive_up": false,
    "trail_note": "Hike of 2-3 miles round trip from a parking area at about 7,500 ft (CalWild). Fire-lookouts.org calls the trail overgrown and puts it at two miles from the parking area to the lookout, about four miles round trip. Forest roads 24S15 and 23S16 are often closed; check with the Western Divide Ranger District."
  },
  "rental": null,
