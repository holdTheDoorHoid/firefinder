  "access": {
    "level": "restricted",
    "note": "On the Qualla Boundary (Eastern Band of Cherokee Indians land). A 2018 blog (July 2018) found a chain-link fence barring entry. An undated trail guide says the tower remains open to the public, but the same guide carries a May 2018 update: BIA Forestry rebuilt the chain-link fence around the base of the tower and closed it until further notice. No later access record found; sources disagree."
  },
  "staffing": {
    "status": "unstaffed",
    "as_of": "1960s (approximate)"
  },
  "visit": {
    "climbable": null,
    "drive_up": false,
    "trail_note": "Hike from the Fire Mountain Trail System, minutes from downtown Cherokee: 2.4 to 2.6 miles and about 1,600 feet of climb, depending on the source. Sources disagree on whether the tower is open (the trail guide's May 2018 update says it was closed until further notice), and the cab floor is missing boards. Do not climb past a fence."
  },
