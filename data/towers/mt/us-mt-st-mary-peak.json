      ]
    },
    {
      "year": 1934,
      "event": "built",
      "note": "Forest improved the site with a lookout house on a 40-ft pole tower (nomination). The volunteer history says CCC built a 50-ft tower in 1934.",
      "from": "research",
      "source_url": "https://npgallery.nps.gov/GetAsset/b5295dad-514a-4700-8762-6f54608a66ab",
      "source_urls": [
        "https://npgallery.nps.gov/GetAsset/b5295dad-514a-4700-8762-6f54608a66ab",
        "https://www.selwaybitterroot.org/archives-gordon-schofield"
      ]
    },
    {
      "year": 1942,
      "event": "staffed_first",
      "note": "Earliest named lookout on firelookout.com's list (Bob Brown, 1942-1943). Staffing before 1952 is disputed.",
      "from": "research",
      "source_url": "https://www.firelookout.com/mt/stmarypeak.html"
    },
    {
      "year": 1951,
      "event": "destroyed",
      "note": "Violent windstorm blew the cab 100 ft down the mountain (nomination); volunteer history says high winds destroyed the lookout in spring 1951.",
      "from": "research",
      "source_url": "https://npgallery.nps.gov/GetAsset/b5295dad-514a-4700-8762-6f54608a66ab",
      "source_urls": [
        "https://npgallery.nps.gov/GetAsset/b5295dad-514a-4700-8762-6f54608a66ab",
        "https://www.selwaybitterroot.org/archives-gordon-schofield"
      ]
    },
    {
      "year": 1953,
      "event": "built",
      "note": "Current 1936-pattern L-4 cab on a stone base completed for $4,970; replaced the earlier lookout structure. Firelookout.com says 1952.",
      "from": "research",
      "source_url": "https://npgallery.nps.gov/GetAsset/b5295dad-514a-4700-8762-6f54608a66ab",
      "source_urls": [
        "https://npgallery.nps.gov/GetAsset/b5295dad-514a-4700-8762-6f54608a66ab",
        "http://nhlr.org/lookouts/us/mt/st-mary-peak-lookout/",
        "https://www.selwaybitterroot.org/archives-gordon-schofield",
        "https://www.firelookout.com/mt/stmarypeak.html"
      ]
    },
    {
      "year": 1956,
      "event": "other",
      "note": "August 1956 inspection by the Assistant Forest Supervisor; regional inspectors began to question the lookout's usefulness for detecting fires in the Bitterroot Valley.",
      "from": "research",
      "source_url": "https://npgallery.nps.gov/GetAsset/b5295dad-514a-4700-8762-6f54608a66ab"
    },
    {
      "year": 1972,
      "event": "closed",
      "note": "Forest Service closed the lookout because of visibility problems from fog and low clouds, and because of rocky alpine terrain in its viewshed (volunteer history).",
      "from": "research",
      "source_url": "https://www.selwaybitterroot.org/archives-gordon-schofield"
    },
    {
      "year": 1975,
      "event": "staffed",
      "note": "Unpaid volunteers stationed at the lookout from 1975 (nomination). This conflicts with the 1972 closure in the volunteer history.",
      "from": "research",
      "source_url": "https://npgallery.nps.gov/GetAsset/b5295dad-514a-4700-8762-6f54608a66ab"
    },
    {
      "year": 1977,
      "event": "staffed",
      "note": "Staffed intermittently by paid staff and volunteers from 1977 until 2009 (volunteer history).",
      "from": "research",
      "source_url": "https://www.selwaybitterroot.org/archives-gordon-schofield"
    },
    {
      "year": 1992,
      "event": "nhlr_registered",
      "note": "Registered on the National Historic Lookout Register, November 27, 1992.",
      "from": "research",
      "source_url": "http://nhlr.org/lookouts/us/mt/st-mary-peak-lookout/"
    },
    {
      "year": 1998,
      "event": "restored",
