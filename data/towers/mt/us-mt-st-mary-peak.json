  "events": [
    {
      "year": 1931,
      "event": "other",
      "note": "NHLR and firelookout.com date a 40-ft pole tower with an L-4 cab to 1931. A 1982 memo cited in the nomination dates the first known fire report from the site to 1931.",
      "from": "research",
      "source_url": "http://nhlr.org/lookouts/us/mt/st-mary-peak-lookout/",
      "source_urls": [
        "http://nhlr.org/lookouts/us/mt/st-mary-peak-lookout/",
