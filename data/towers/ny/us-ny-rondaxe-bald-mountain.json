      ]
    },
    {
      "year": 2006,
      "event": "modified",
      "note": "A new all-weather composite map table was installed in the cab on work days in late June and early July.",
      "from": "bald_mountain_friends",
      "source_url": "http://www.masterpieces.com/bald9a.htm"
    },
    {
      "year": 2007,
      "event": "restored",
      "note": "A volunteer re-stained all the tower's steps, cab floor and landings.",
