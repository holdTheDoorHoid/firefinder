    },
    {
      "year": 2003,
      "event": "restored",
      "note": "Volunteers scraped rust, removed worn fencing and the lower steps, painted the tower in July and August, and on 20 September began fitting new treated steps.",
      "from": "bald_mountain_friends",
      "source_url": "http://www.masterpieces.com/bald2.htm"
    },
    {
      "year": 2004,
      "event": "modified",
      "note": "Security fencing went in along the stairs and platforms, and a steel safety railing inside the cab in November, the season's last big job.",
      "from": "bald_mountain_friends",
      "source_url": "http://www.masterpieces.com/bald14.htm",
      "source_urls": [
        "http://www.masterpieces.com/bald14.htm",
