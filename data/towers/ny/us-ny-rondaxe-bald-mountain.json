      ]
    },
    {
      "year": 2004,
      "event": "restored",
      "note": "Friends of Bald Mountain and NYSDEC (work began after 2002) scraped and painted the tower, replaced steps, cab floor, safety wire and windows, and repaired footings; reopened by 2004.",
      "from": "nysffla_projects",
      "source_url": "https://www.nysffla.org/Newsletters/2017/2017-02.pdf"
    },
    {
      "year": 2005,
      "event": "other",
      "note": "The restored tower was formally reopened at a dedication with a ribbon cutting on 18 June; a new map table with an alidade was in the cab.",
