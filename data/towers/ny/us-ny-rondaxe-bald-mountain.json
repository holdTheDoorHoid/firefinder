    },
    {
      "year": 2009,
      "event": "restored",
      "note": "Volunteers re-stained the wooden steps, landings and other wood parts at a September work weekend, and hung a new swing safety door at the cab entrance.",
      "from": "bald_mountain_friends",
      "source_url": "http://www.masterpieces.com/bald9z.htm"
    },
    {
      "year": 2023,
      "event": "modified",
      "note": "Fred Knauf replaced the Bald Mountain cab's observer map table with a new UV-protected map, aligned on three peaks and screwed down (reported Sept 2023).",
