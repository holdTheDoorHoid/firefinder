      ]
    },
    {
      "year": 1927,
      "event": "fire",
      "note": "During August 1927 fires on the Columbia National Forest a newspaper said the Siouxon, Gumboot and Lookout Mountain stations were believed likely to burn and the instruments removed and houses abandoned",
      "from": "research",
      "source_url": "https://washingtonlookouts.weebly.com/lookout-mountain5.html"
    },
    {
      "year": 1933,
      "event": "fire",
      "note": "Lightning set an old snag no more than 150 feet from the lookout cabin on fire on August 29; the lookout reported it and a five-person crew from Co. 605 put it out that evening. A Lookout Mountain Camp was in operation at this time",
      "from": "research",
      "source_url": "https://washingtonlookouts.weebly.com/lookout-mountain5.html"
    },
    {
      "year": 1934,
      "event": "staffed",
      "note": "In a 2002 interview, Pete Paladeni recalled CCC camp work near Lookout Mountain in 1934 and said he was stationed at the lookout about three weeks",
      "from": "research",
      "source_url": "http://www.willhiteweb.com/washington_fire_lookouts/lookout_mountain_yacolt/fire_lookout_222.htm"
    },
    {
      "year": 1941,
      "event": "replaced",
      "note": "FFLOS: a 20-foot wooden L-4 tower replaced the cabin in 1941. FireLookout.com lists a 10-foot L-4 tower dated 1941 with a question mark. Willhite places a second 10-foot L-4 cab in the early 1940s",
      "from": "research",
      "source_url": "http://firetower.org/lookouts/us/wa/lookout-mountain-lookout-site-skamania-county/",
