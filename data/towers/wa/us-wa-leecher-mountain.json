    "climbable": null,
    "drive_up": false,
    "trail_note": "Drive Benson Creek Drive about 10 miles to spur Road 100, then 3 miles to a parking area at a locked gate. Hike listed as 2.4 mi round trip with 531 ft gain (WTA)."
  },
