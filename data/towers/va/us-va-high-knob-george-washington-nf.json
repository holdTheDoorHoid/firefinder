    "from": "nhlr"
  },
  "elevation_m": 1251.8,
  "kind": "two_story",
  "material": null,
  "material_from": null,
  "roles": [],
  "design": "About 20 ft stone base with a wooden 14x14 ft cab and catwalk; the only stone lookout in Virginia",
  "height_m": null,
  "status": "standing",
  "status_note": null,
  "registers": [
    {
      "register": "NHLR",
      "number": "US 76",
