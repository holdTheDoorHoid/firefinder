    }
  ],
  "agency": "U.S. Forest Service (George Washington National Forest, Dry River Ranger District)",
  "ownership": "federal",
  "access": {
    "level": "restricted",
    "note": "Trail and tower exterior open to hikers; the cab interior was not open to visitors at the May 2018 NHLR visit, and the visitor wished it could be opened"
  },
  "staffing": {
    "status": "unknown",
    "as_of": null
  },
  "visit": {
    "climbable": true,
    "drive_up": false,
    "trail_note": "2.5-mile out-and-back trail, about 1.5 to 2.5 hours, about 643 ft of elevation change; trailhead about 30 minutes west of Harrisonburg by car"
  },
  "rental": null,
  "events": [
    {
      "year": 1939,
      "event": "built",
      "note": "Construction started in 1939 by World War I veterans under John Moffett; NHLR's Built field gives 1939, while its description says the tower was completed in 1940 by CCC Camp #2 crews",
      "from": "research",
      "source_url": "http://nhlr.org/lookouts/us/va/high-knob-lookout-george-washington-nf/",
      "source_urls": [
        "http://nhlr.org/lookouts/us/va/high-knob-lookout-george-washington-nf/",
        "http://www.friendsofshenandoahmountain.org/history-of-high-knob-fire-tower.html"
      ]
    },
    {
      "year": 1940,
      "event": "staffed",
      "note": "Gerald Fawley moved from a tree platform into the finished stone tower for the 1940 fire season and stayed three more seasons",
      "from": "research",
      "source_url": "http://www.friendsofshenandoahmountain.org/history-of-high-knob-fire-tower.html"
    },
    {
      "year": 1972,
      "event": "other",
      "note": "Forest Service memo proposed declaring the forest's fire towers surplus and removing them, except Elliott Knob and Reddish Knob; a district ranger asked to keep High Knob",
      "from": "research",
      "source_url": "http://www.friendsofshenandoahmountain.org/history-of-high-knob-fire-tower.html"
    },
    {
      "year": 1994,
      "event": "nhlr_registered",
      "note": "Registered January 27, 1994 on the National Historic Lookout Register as US 76 (VA 1)",
      "from": "research",
      "source_url": "http://nhlr.org/lookouts/us/va/high-knob-lookout-george-washington-nf/"
    },
    {
      "year": 2003,
      "event": "restored",
      "note": "NHLR says restored in 2003; trail guide says restored from 2001 to 2003",
